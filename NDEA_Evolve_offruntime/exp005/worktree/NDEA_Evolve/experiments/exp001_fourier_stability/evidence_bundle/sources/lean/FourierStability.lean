import Mathlib

namespace NDEAEvolve.Exp001

noncomputable section

/-- The unit complex phase associated with a real Fourier angle. -/
def unitPhase (θ : ℝ) : ℂ :=
  Complex.exp ((θ : ℂ) * Complex.I)

/-- The real centered negative-Laplacian stencil symbol before half-angle simplification. -/
def realStencilSymbol (θ : ℝ) : ℝ :=
  2 - 2 * Real.cos θ

/-- The same stencil symbol expressed through the two neighboring complex phases. -/
def complexStencilSymbol (θ : ℝ) : ℂ :=
  2 - unitPhase θ - unitPhase (-θ)

/-- The centered negative discrete-Laplacian eigenvalue for grid spacing `h`. -/
def fourierEigenvalue (h θ : ℝ) : ℝ :=
  realStencilSymbol θ / h ^ 2

/-- The local centered negative-Laplacian action on Fourier-neighbor data. -/
def centeredFourierStencil (h θ : ℝ) (u : ℂ) : ℂ :=
  ((2 : ℂ) * u - unitPhase θ * u - unitPhase (-θ) * u) / (h : ℂ) ^ 2

/-- Numerator of the scalar Cayley transform for a real parameter. -/
def cayleyNumerator (a : ℝ) : ℂ :=
  1 - Complex.I * (a : ℂ)

/-- Denominator of the scalar Cayley transform for a real parameter. -/
def cayleyDenominator (a : ℝ) : ℂ :=
  1 + Complex.I * (a : ℂ)

/-- Scalar Cayley amplification factor. -/
def cayleyFactor (a : ℝ) : ℂ :=
  cayleyNumerator a / cayleyDenominator a

/-- The real Cayley parameter generated by timestep `k` and the Fourier eigenvalue. -/
def cayleyParameter (h k θ : ℝ) : ℝ :=
  (k / 2) * fourierEigenvalue h θ

/-- Cayley–Crank–Nicolson amplification factor for a centered Fourier mode. -/
def cayleyAmplification (h k θ : ℝ) : ℂ :=
  cayleyFactor (cayleyParameter h k θ)

/-- Each Fourier phase lies on the unit circle. -/
theorem unitPhase_norm_one (θ : ℝ) :
    ‖unitPhase θ‖ = 1 := by
  simp [unitPhase]

/-- Opposite Fourier phases add to twice the real cosine. -/
theorem unitPhase_add_neg (θ : ℝ) :
    unitPhase θ + unitPhase (-θ) = ((2 * Real.cos θ : ℝ) : ℂ) := by
  unfold unitPhase
  rw [Complex.exp_ofReal_mul_I θ, Complex.exp_ofReal_mul_I (-θ)]
  rw [Real.cos_neg, Real.sin_neg]
  push_cast
  ring

/-- The phase stencil is exactly the real cosine stencil. -/
theorem complexStencilSymbol_eq_realStencilSymbol (θ : ℝ) :
    complexStencilSymbol θ = (realStencilSymbol θ : ℂ) := by
  calc
    complexStencilSymbol θ = 2 - (unitPhase θ + unitPhase (-θ)) := by
      simp [complexStencilSymbol]
      ring
    _ = 2 - ((2 * Real.cos θ : ℝ) : ℂ) := by
      rw [unitPhase_add_neg]
    _ = (realStencilSymbol θ : ℂ) := by
      simp [realStencilSymbol]

/-- Exact half-angle simplification of the centered stencil symbol. -/
theorem realStencilSymbol_eq_four_sin_sq (θ : ℝ) :
    realStencilSymbol θ = 4 * Real.sin (θ / 2) ^ 2 := by
  unfold realStencilSymbol
  have hc := Real.cos_two_mul_eq_one_sub (θ / 2)
  have harg : (2 : ℝ) * (θ / 2) = θ := by ring
  rw [harg] at hc
  rw [hc]
  ring

/-- The Fourier eigenvalue in the standard nonnegative sine-square form. -/
theorem fourierEigenvalue_sine_form (h θ : ℝ) :
    fourierEigenvalue h θ =
      (4 / h ^ 2) * Real.sin (θ / 2) ^ 2 := by
  unfold fourierEigenvalue
  rw [realStencilSymbol_eq_four_sin_sq]
  ring

/-- Nonnegativity of the centered negative-Laplacian Fourier eigenvalue. -/
theorem fourierEigenvalue_nonneg (h θ : ℝ) (hh : h ≠ 0) :
    0 ≤ fourierEigenvalue h θ := by
  rw [fourierEigenvalue_sine_form]
  have hh2 : 0 < h ^ 2 := sq_pos_of_ne_zero hh
  exact mul_nonneg (div_nonneg (by norm_num) hh2.le) (sq_nonneg _)

/-- The complex centered stencil acts diagonally on local Fourier-neighbor data. -/
theorem centeredFourierStencil_eigen_relation (h θ : ℝ) (u : ℂ) :
    centeredFourierStencil h θ u = (fourierEigenvalue h θ : ℂ) * u := by
  rw [centeredFourierStencil, fourierEigenvalue, Complex.ofReal_div,
    Complex.ofReal_pow, ← complexStencilSymbol_eq_realStencilSymbol]
  unfold complexStencilSymbol
  ring

/-- Exact squared norm of the Cayley numerator. -/
theorem cayleyNumerator_normSq (a : ℝ) :
    Complex.normSq (cayleyNumerator a) = 1 + a ^ 2 := by
  simp [cayleyNumerator, Complex.normSq_apply]
  ring

/-- Exact squared norm of the Cayley denominator. -/
theorem cayleyDenominator_normSq (a : ℝ) :
    Complex.normSq (cayleyDenominator a) = 1 + a ^ 2 := by
  simp [cayleyDenominator, Complex.normSq_apply]
  ring

/-- The Cayley denominator cannot vanish for a real parameter. -/
theorem cayleyDenominator_ne_zero (a : ℝ) :
    cayleyDenominator a ≠ 0 := by
  rw [← Complex.normSq_pos, cayleyDenominator_normSq]
  positivity

/-- Numerator and denominator of the real Cayley transform have equal norm. -/
theorem cayleyNumerator_norm_eq_denominator_norm (a : ℝ) :
    ‖cayleyNumerator a‖ = ‖cayleyDenominator a‖ := by
  rw [Complex.norm_def, Complex.norm_def,
    cayleyNumerator_normSq, cayleyDenominator_normSq]

/-- The Cayley factor solves its scalar Crank–Nicolson update equation. -/
theorem cayleyFactor_satisfies_update (a : ℝ) :
    cayleyDenominator a * cayleyFactor a = cayleyNumerator a := by
  unfold cayleyFactor
  field_simp [cayleyDenominator_ne_zero]

/-- A Cayley transform of a real scalar has unit complex modulus. -/
theorem cayleyFactor_norm_one (a : ℝ) :
    ‖cayleyFactor a‖ = 1 := by
  rw [cayleyFactor, Complex.norm_div,
    cayleyNumerator_norm_eq_denominator_norm]
  exact div_self (norm_ne_zero_iff.mpr (cayleyDenominator_ne_zero a))

/-- The Fourier amplification factor has the target explicit fraction. -/
theorem cayleyAmplification_eq_fraction (h k θ : ℝ) :
    cayleyAmplification h k θ =
      ((1 : ℂ) - Complex.I * (cayleyParameter h k θ : ℂ)) /
      ((1 : ℂ) + Complex.I * (cayleyParameter h k θ : ℂ)) := by
  rfl

/-- The Fourier amplification factor satisfies the scalar update equation. -/
theorem cayleyAmplification_satisfies_update (h k θ : ℝ) :
    cayleyDenominator (cayleyParameter h k θ) * cayleyAmplification h k θ =
      cayleyNumerator (cayleyParameter h k θ) := by
  simpa [cayleyAmplification] using
    cayleyFactor_satisfies_update (cayleyParameter h k θ)

/--
Headline result: for positive grid spacing, the centered periodic Fourier symbol
has the expected nonnegative eigenvalue, all required denominators are nonzero,
the Cayley update equation holds, and its amplification factor has unit modulus.
-/
theorem cayleyCN_fourier_mode_stability (h k θ : ℝ) (hh : 0 < h) :
    fourierEigenvalue h θ =
        (4 / h ^ 2) * Real.sin (θ / 2) ^ 2 ∧
      0 ≤ fourierEigenvalue h θ ∧
      h ^ 2 ≠ 0 ∧
      cayleyDenominator (cayleyParameter h k θ) ≠ 0 ∧
      cayleyDenominator (cayleyParameter h k θ) * cayleyAmplification h k θ =
        cayleyNumerator (cayleyParameter h k θ) ∧
      ‖cayleyAmplification h k θ‖ = 1 := by
  refine ⟨fourierEigenvalue_sine_form h θ, ?_⟩
  refine ⟨fourierEigenvalue_nonneg h θ (ne_of_gt hh), ?_⟩
  refine ⟨pow_ne_zero 2 (ne_of_gt hh), ?_⟩
  refine ⟨cayleyDenominator_ne_zero (cayleyParameter h k θ), ?_⟩
  refine ⟨cayleyAmplification_satisfies_update h k θ, ?_⟩
  exact cayleyFactor_norm_one (cayleyParameter h k θ)

end

end NDEAEvolve.Exp001
